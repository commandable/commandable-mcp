# Wise live integration tests (sandbox API — personal_token_sandbox credential variant)
#
# Copy to .env.test in this directory (ignored by git) and fill in values.
# Vitest loads integrations/<integration>/.env.test automatically — see vitest.config.ts.
#
# Create a sandbox account and personal API token:
# - https://wise-sandbox.com/ → Your account → Connect and manage apps → API tokens
#
# Sandbox tokens only work against https://api.wise-sandbox.com (not production wise.com).
#
# Required — handlers + health check suites skip when this is empty:
WISE_SANDBOX_API_TOKEN=
