{
  "variants": {
    "custom_connection": {
      "label": "Custom Connection",
      "schema": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "title": "Client ID",
            "description": "Xero app client ID for a Custom Connection."
          },
          "clientSecret": {
            "type": "string",
            "title": "Client Secret",
            "description": "Xero app client secret for the Custom Connection.",
            "format": "password"
          }
        },
        "required": ["clientId", "clientSecret"],
        "additionalProperties": false
      },
      "preprocess": {
        "type": "handler",
        "handler": "handlers/auth/get_access_token.js",
        "allowedOrigins": ["https://identity.xero.com"]
      },
      "injection": {
        "headers": {
          "Authorization": "Bearer {{token}}",
          "Accept": "application/json"
        }
      },
      "healthCheck": { "notViable": true }
    }
  },
  "default": "custom_connection"
}
